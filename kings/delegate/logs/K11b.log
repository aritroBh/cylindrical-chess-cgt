      } else emit(out, m, &s, 0, 0, 'P', from, to, promoType[i]);
    }
    return;
  }
  if (us == WHITE) q.wp |= BIT(to);
  else q.bp |= BIT(to);
  if (in_check(&q, us)) return;
  q.stm = them;
  emit(out, m, &q, 0, 0, 'P', from, to, 0);
}

static int gen_moves(const Pos *p, Child *out) {
