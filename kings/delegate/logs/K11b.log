  uint64_t ownO = 0, oppO = 0;
  for (int j = 0; j < p->no; j++) {
    if (colour_of(p->ot[j]) == us) ownO |= BIT(p->osq[j]);
    else oppO |= BIT(p->osq[j]);
  }
  int ok = us == BLACK ? p->bk : p->wk, ek = us == BLACK ? p->wk : p->bk;
