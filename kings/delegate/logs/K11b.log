}

typedef struct { uint32_t *a; size_t n, cap; } Vec;
static void vpush(Vec *v, uint32_t x) {
  if (v->n == v->cap) {
    v->cap = v->cap ? 2 * v->cap : 1 << 12;
    v->a = realloc(v->a, v->cap * sizeof *v->a);
  }
  v->a[v->n++] = x;
}


