    if (us == BLACK) q.bk = n;
    else q.wk = n;
    capture_at(&q, n, them);
    if (in_check(&q, us)) continue;
    q.stm = them;
    if (FROZEN) emit(out, &m, &q, 1, them, 'K', ok, n, 0);
