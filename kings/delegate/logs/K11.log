      if (!((dest >> s) & 1)) continue;
      Pos q = *p;
      q.ep = -1;
      q.osq[j] = s;
      capture_at(&q, s, them);
      if (in_check(&q, us)) continue;
      q.stm = them;
      emit(out, &m, &q, 0, 0, TYPECH[t], from, s, 0);
    }
  }

  /* pawns */
  int dir = us == WHITE ? W : -W, start = us == WHITE ? 1 : H - 2;
  for (int s = 0; s < N; s++) {
    if (!((ownP >> s) & 1)) continue;
    int t = s + dir;
    if (!((occ >> t) & 1)) {
      pawn_move(p, s, t, -1, out, &m);
      int t2 = t + dir;
      if (s / W == start && t2 / W == (us == WHITE ? H - 1 : 0) && !((occ >> t2) & 1))
        pawn_move(p, s, t2, -1, out, &m); /* 4-rank board: the double step promotes, no e.p. */
      else if (s / W == start && !((occ >> t2) & 1)) {
        Pos q = *p;
        q.ep = -1;
        if (us == WHITE) q.wp = (q.wp & ~BIT(s)) | BIT(t2);
        else q.bp = (q.bp & ~BIT(s)) | BIT(t2);
