      }
    }
    for (int i = 0; i < capN[us][s]; i++) {
      int c = capL[us][s][i];
      if (((oppP | oppO) >> c) & 1) pawn_move(p, s, c, c, out, &m);
      else if (c == p->ep) pawn_move(p, s, c, c - dir, out, &m);
    }
  }
  return m;
}

