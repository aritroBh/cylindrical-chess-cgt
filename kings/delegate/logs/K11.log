        int k = rayN[s][d]++;
        rayL[s][d][k] = cur;
        rayIdx[s][d][cur] = (int8_t)k;
        rayBefore[s][d][k] = before;
        before |= BIT(cur);
      }
    }
    for (int c = 0; c < 2; c++) {
