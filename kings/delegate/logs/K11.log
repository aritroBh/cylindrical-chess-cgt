+    assert not pawns.passed(BOARD, uncertified, "B")
+    assert cgt.outcome(W(BOARD, uncertified)) == "L"
+    print("uncertified P11 root:", miss, "W(X)=White wins")
+
+
+if __name__ == "__main__":
+    main()
