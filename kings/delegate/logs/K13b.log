+      items[i].moves[1] = items[i].moves[0];
+    }
+  for (int i = 0; i < n; i++) {
+    if (items[i].ok < 0) { printf("%s\n", items[i].line); continue; }
+    printf("%s | %c %c", items[i].line, items[i].res[0], items[i].res[1]);
+    if (WANTMOVES && items[i].moves[0]) {
