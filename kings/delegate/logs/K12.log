import json
meta=json.load(open('kings/delegate/out/K12/meta.json'))
def agree(m):
    if m['beta']=='W':
        return m['frozen_A']=='W'
    else:
        return m['frozen_A']=='L'
# attach
for m in meta:
    m['agree']=agree(m)
# board tables
for (W,H) in sorted(set((m['W'],m['H']) for m in meta)):
    sub=[m for m in meta if m['W']==W and m['H']==H]
    print(f"\nBoard {W}x{H}: roots={len(sub)}")
    for label in ['single','race']:
        ss=[m for m in sub if m[label]]
        print(f"  {label}: n={len(ss)} cert={sum(m['certified'] for m in ss)}")
        for cert in [True,False]:
            for ag in [True,False]:
                cnt=sum(1 for m in ss if m['certified']==cert and m['agree']==ag)
                print(f"     cert={cert} agree={ag}: {cnt}")
    # violations
    viols=[m for m in sub if m['certified'] and not m['agree']]
    print(f"  violations certified&disagree: {len(viols)}")
# totals
print('\nTOTAL')
for label in ['single','race']:
    ss=[m for m in meta if m[label]]
    print(label, 'n', len(ss), 'cert', sum(m['certified'] for m in ss))
    for cert in [True,False]:
        for ag in [True,False]:
            print(f"  cert={cert} agree={ag}:", sum(1 for m in ss if m['certified']==cert and m['agree']==ag))
print('total violations', sum(1 for m in meta if m['certified'] and not m['agree']))
