+            "assertions_per_position": 6}
+
+
+def main():
+    rng = random.Random(330027)
+    print(json.dumps({
+        "seed": 330027,
+        "generator": "independent directed edges: node probability .22, allowed terminal probability .14; roots 0; n=1..4; B=1..4; seed 330027",
