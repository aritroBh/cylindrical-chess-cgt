        if turn==0 and t>0: out.append((nodes,t-1,1))
        return out
    while stack:
        s=stack.pop()
        if s in seen: continue
        seen.add(s); states.append(s)
        stack.extend(opts(s))
    moves={s:opts(s) for s in states}
    win={s for s in states if s[2]==1 and not moves[s]}
    changed=True
    while changed:
