def _pawn_value(board,pos):
    # not lru on pos? board hashable? Board dataclass frozen yes. Pos frozen. Use dict.
    key=(board,pos)
    if key in _pawn_value_cache: return _pawn_value_cache[key]
    import cylcgt.pawns as P
