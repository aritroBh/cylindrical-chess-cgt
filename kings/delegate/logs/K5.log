import csv
rows=list(csv.reader(open('kings/delegate/out/K5/targets.tsv'),delimiter='\t'))
# header
hdr=rows[0]; data=rows[1:]
# group
from collections import defaultdict
by=defaultdict(dict)
for r in data:
    t=r[0]; setting=r[1]; own=r[2]; eqcyl=r[3]; eqclaim=r[4]; sec=r[5]
    by[t][setting]=(own,eqcyl,eqclaim,sec)
for t in sorted(by, key=int):
    print(f"\n### Target {t}")
    print("| ep \\ race | count | mover | opponent |")
    print("|---|---|---|---|")
    for ep in ("off","textbook","aware"):
        cells=[]
        for race in ("count","mover","opponent"):
            own,eqcyl,eqclaim,sec=by[t][f"{ep}/{race}"]
            cell=f"{own} (cyl {eqcyl}, claim {eqclaim})"
            cells.append(cell)
        print(f"| {ep} | " + " | ".join(cells) + " |")
