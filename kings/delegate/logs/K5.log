    if R == (ZERO,) and len(L) == 1 and L[0].R == (ZERO,) and len(L[0].L) == 1 and L[0].L[0].num is not None:
        return f"miny({fmt_num(L[0].L[0].num)})"
    return "{" + ", ".join(show(x) for x in L) + " | " + ", ".join(show(x) for x in R) + "}"


