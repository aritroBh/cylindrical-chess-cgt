import subprocess
import sys

# Generate all positions for KPK on cyl:4x4
import itertools
W, H = 4, 4
FILES = 'abcdefgh'
sqs = [(f, r) for f in range(W) for r in range(1, H + 1)]
pawn_sqs = [(f, r) for f, r in sqs if 2 <= r <= H - 1]

def adjacent(a, b):
    df = abs(a[0] - b[0])
    df = min(df, W - df)
    return max(df, abs(a[1] - b[1])) <= 1

material = 'KPK'
white = material[1:material.index('K', 1)]
black = material[material.index('K', 1) + 1:]

lines = []
for wk, bk in itertools.permutations(sqs, 2):
    if adjacent(wk, bk):
        continue
    free = [s for s in pawn_sqs if s not in (wk, bk)]
    for wp in itertools.combinations(free, 1):
        rest = [s for s in free if s not in wp]
        for bp in itertools.combinations(rest, 0):
            toks = [f'K{FILES[wk[0]]}{wk[1]}', f'k{FILES[bk[0]]}{bk[1]}']
            toks += [f'P{FILES[f]}{r}' for f, r in wp] + [f'p{FILES[f]}{r}' for f, r in bp]
            for stm in 'wb':
                lines.append(' '.join(toks) + f' {stm} -')

inp = '\n'.join(lines) + '\n'
print(f'Total positions: {len(lines)}')

# Test with reference solver
r = subprocess.run([sys.executable, '-m', 'kings.ref.solve', '--board', 'cyl:4x4', '--cap', '1', '--promote', 'QRBN', '--ep', 'on'], input=inp, capture_output=True, text=True)
print('returncode:', r.returncode)
if r.returncode != 0:
    print('stderr:', r.stderr[:500])
    print('stdout:', r.stdout[:500])
"
Total positions: 1952
