diff --git a/kings/delegate/out/K8/chess_scan.py b/kings/delegate/out/K8/chess_scan.py
new file mode 100644
index 0000000000000000000000000000000000000000..8da56a9cd7dab0562b713cc6c44613f390d74230
--- /dev/null
+++ b/kings/delegate/out/K8/chess_scan.py
@@ -0,0 +1,115 @@
+"""K8 chess-stalemate variant: tempo profiles and kpsolve zugzwang comparison."""
+import collections
+import json
+import os
+import sys
+import time
+
+import check1
+import graph
+import testgames as tg
+from product import solve_product
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RANGE = range(-10, 11)
+FINITE = tg.TESTS[:11]
+RANK = {'L': 0, 'D': 1, 'W': 2}
+
+
+def pair(res, c, T):
+    return 'DWL'[res[c[0] * T.n + T.start]] + 'DWL'[res[c[1] * T.n + T.start]]
+
+
+def scan(board):
+    t0 = time.time()
+    cg = graph.ChessGraph(board)
+
+    # The chess-rule T=0 check is the gate: it compares every legal graph node to kpsolve.
+    c1 = check1.check1(cg, os.path.join(HERE, 'check1'))
+    if c1['diffs']:
+        path = os.path.join(HERE, 'FAILED_chess_check1_%s.json' % board.replace(':', '_'))
+        json.dump(c1, open(path, 'w'), indent=1)
+        raise SystemExit('CHECK 1 FAILED on %s; see %s' % (board, path))
+
+    profiles = {c: [] for c in cg.quiet_kpk}
+    for name in FINITE:
+        T = tg.GAMES[name]
+        res = solve_product(cg, T, stalemate_draw=True)
+        for c in profiles:
+            profiles[c].append(pair(res, c, T))
+
+    nprofiles = {c: [] for c in cg.quiet_kpk}
+    for n in RANGE:
+        T = tg.integer(n)
+        res = solve_product(cg, T, stalemate_draw=True)
+        for c in nprofiles:
+            nprofiles[c].append(pair(res, c, T))
+
+    # T=0 must agree for every quiet placement too, as a local assertion on this scan.
+    zidx = list(RANGE).index(0)
+    for c in cg.quiet_kpk:
+        assert nprofiles[c][zidx] == ''.join(c1['kpk_outcomes'][cg.placement(c[0])])
+
+    mutual = set(c1['mutual_placements'])
+    thresholds = collections.Counter()
+    test_sensitive = n_sensitive = pm1_sensitive = 0
+    rows = []
+    for c in sorted(cg.quiet_kpk, key=lambda p: cg.placement(p[0])):
+        pl = cg.placement(c[0])
+        finite = profiles[c]
+        ns = nprofiles[c]
+        test_sens = len(set(finite)) > 1
+        n_sens = len(set(ns)) > 1
+        pm1_sens = ns[zidx - 1] != ns[zidx] or ns[zidx + 1] != ns[zidx]
+        jumps = [n for n, a, b in zip(RANGE, ns, ns[1:]) if a != b]
+        thresholds.update(jumps)
+        test_sensitive += test_sens
+        n_sensitive += n_sens
+        pm1_sensitive += pm1_sens
+        rows.append(dict(placement=pl, finite_tests=dict(zip(FINITE, finite)),
+                         n_profile=dict(zip(map(str, RANGE), ns)),
+                         thresholds=jumps, sensitive_to_finite_tests=test_sens,
+                         sensitive_to_n_scan=n_sens, tempo_sensitive=test_sens or n_sens,
+                         sensitive_at_pm1=pm1_sens, kpsolve=c1['kpk_outcomes'][pl],
+                         mutual_zugzwang=pl in mutual))
+
+    sensitive = [r for r in rows if r['tempo_sensitive']]
+    pm1_set = {r['placement'] for r in rows if r['sensitive_at_pm1']}
+    mutual_only = mutual - pm1_set
+    pm1_only = pm1_set - mutual
+    tag = board.replace(':', '_')
+    jlpath = os.path.join(HERE, 'chess_tempo_%s.jsonl' % tag)
+    with open(jlpath, 'w') as f:
+        for row in rows:
+            f.write(json.dumps(row, ensure_ascii=False) + '\n')
+
+    meta = dict(board=board, nodes=cg.n, edges=len(cg.succ), kpk_positions=len(cg.kpk),
+                quiet_placements=len(cg.quiet_kpk), check1={k: v for k, v in c1.items()
+                    if k not in ('diffs', 'mutual_placements', 'kpk_outcomes')},
+                check1_differences=0, mutual_examples=c1['mutual_placements'][:5])
+    json.dump(meta, open(os.path.join(HERE, 'meta_chess_%s.json' % tag), 'w'), indent=1)
+
+    detail = dict(label='COMPUTED-1', board=board, rule='chess stalemate draw; checkmate loss',
+                  quiet=len(rows), kpsolve_check=dict(passed=True, kpk=c1['kpk'], other=c1['other'],
+                      compared=c1['kpk'] + c1['other'], differences=0),
+                  tempo_sensitive=len(sensitive), sensitive_to_finite_tests=test_sensitive,
+                  sensitive_to_n_scan=n_sensitive,
+                  thresholds={str(k): v for k, v in sorted(thresholds.items())},
+                  sensitive_at_pm1=len(pm1_set), mutual_zugzwangs=len(mutual),
+                  mutual_also_pm1=len(mutual & pm1_set), mutual_not_pm1=len(mutual_only),
+                  pm1_not_mutual=len(pm1_only),
+                  mutual_not_pm1_examples=sorted(mutual_only)[:5],
+                  pm1_not_mutual_examples=sorted(pm1_only)[:5],
+                  sensitive_examples=sensitive[:5], per_placement_jsonl=os.path.basename(jlpath),
+                  seconds=round(time.time() - t0, 1))
+    json.dump(detail, open(os.path.join(HERE, 'tempo_detail_%s.json' % tag), 'w'),
+              indent=1, ensure_ascii=False)
+    print(json.dumps({k: v for k, v in detail.items() if k != 'sensitive_examples'}, ensure_ascii=False),
+          flush=True)
+    return detail
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 2:
+        raise SystemExit('usage: chess_scan.py BOARD')
+    scan(sys.argv[1])
