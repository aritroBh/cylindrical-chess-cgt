"""Run one command with limits and measure it:  runlim.py LABEL MAX_SECONDS MAX_RSS_MB OUTFILE -- cmd ...

Polls `ps` ~5 times a second for the command and its descendants (processes this script started).
If any single process exceeds MAX_RSS_MB, or the wall time exceeds MAX_SECONDS, it terminates its OWN process
group (only processes it started) and exits 99.  Appends one JSON line to <OUTFILE>:
label, rc, seconds, peak_single_rss_mb, peak_total_rss_mb, killed (None | 'rss' | 'time'), tree_maxrss_mb (exact peak RSS of the largest process in the tree).
"""
import json
import os
import resource
import signal
import subprocess
import sys
import time


def snapshot():
    out = subprocess.run(['ps', '-axo', 'pid=,ppid=,rss='], capture_output=True, text=True).stdout
    rows = {}
    for line in out.splitlines():
        try:
            pid, ppid, rss = map(int, line.split())
        except ValueError:
            continue
        rows[pid] = (ppid, rss)
    return rows


def descendants(rows, root):
    kids = {root}
    changed = True
    while changed:
        changed = False
        for pid, (ppid, _) in rows.items():
            if ppid in kids and pid not in kids:
                kids.add(pid)
                changed = True
    return kids


def main():
    label, max_s, max_mb, outfile = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), sys.argv[4]
    cmd = sys.argv[sys.argv.index('--') + 1:]
    t0 = time.time()
    p = subprocess.Popen(cmd, start_new_session=True)
    peak_single = peak_total = 0
    killed = None
    while p.poll() is None:
        rows = snapshot()
        mine = descendants(rows, p.pid)
        rss = [rows[x][1] for x in mine if x in rows]
        if rss:
            peak_single = max(peak_single, max(rss))
            peak_total = max(peak_total, sum(rss))
        if max(rss or [0]) / 1024.0 > max_mb:
            killed = 'rss'
        elif time.time() - t0 > max_s:
            killed = 'time'
        if killed:
            os.killpg(p.pid, signal.SIGTERM)     # our own process group only
            time.sleep(1.0)
            if p.poll() is None:
                os.killpg(p.pid, signal.SIGKILL)
            break
        time.sleep(0.2)
    rc = p.wait()
    rec = dict(label=label, rc=rc, seconds=round(time.time() - t0, 1), peak_single_rss_mb=round(peak_single / 1024.0, 1),
               peak_total_rss_mb=round(peak_total / 1024.0, 1), killed=killed,
               # exact: largest RSS of any process in the waited-for tree (bytes on macOS)
               tree_maxrss_mb=round(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss / 1048576.0, 1))
    with open(outfile, 'a') as f:
        f.write(json.dumps(rec) + '\n')
    print(json.dumps(rec), flush=True)
    sys.exit(99 if killed else rc)


main()
"""K6: one summary record per board, from the files the pipeline wrote.

    PYTHONPATH=. .venv/bin/python kings/delegate/out/K6/summarize.py flat:6x4 cyl:7x4 ... > summary.json

Reads meta_<board>.json, <board>.jsonl, tempo_detail_<board>.json, runs.jsonl.
"""
import collections
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def sig_kind(sig):
    pairs = {sig[i:i + 2] for i in range(0, len(sig), 2)}
    return pairs.pop() if len(pairs) == 1 else None


def summarize(board):
    tag = board.replace(':', '_')
    meta = json.load(open(os.path.join(HERE, 'meta_%s.json' % tag)))
    rows = [json.loads(l) for l in open(os.path.join(HERE, tag + '.jsonl'))]
    td = json.load(open(os.path.join(HERE, 'tempo_detail_%s.json' % tag)))
    c = collections.Counter()
    for r in rows:
        if r['cls'] == 'unmatched':
            c['unmatched, T-independent' if sig_kind(r['sig']) else 'unmatched, T-dependent'] += 1
        else:
            c[r['cls']] += 1
    runs = [json.loads(l) for l in open(os.path.join(HERE, 'runs.jsonl'))]
    mine = [r for r in runs if r['label'] in ('gafni ' + board, 'tempo_scan ' + board)]
    ck = meta['check1']
    out = dict(board=board, quiet=meta['quiet_placements'], nodes=meta['nodes'], edges=meta['edges'],
               kpk_positions=meta['kpk_positions'], kpsolve_kpk=ck['kpk'], kpsolve_other=ck['other'],
               kpsolve_compared=ck['kpk'] + ck['other'], kpsolve_diffs=meta['check1_differences'],
               tempo_sensitive=td['tempo_sensitive'], sens_finite_tests=td['sensitive_to_finite_tests'],
               sens_n_scan=td['sensitive_to_n_scan'], thresholds=td['thresholds'],
               WHITE_WINS_ALL=c['WHITE-WINS-ALL'], BLACK_WINS_ALL=c['BLACK-WINS-ALL'], on=c['on/on+*'],
               off=c['off/off+*'], dud=c['dud'], unmatched_Tdep=c['unmatched, T-dependent'],
               unmatched_Tindep=c['unmatched, T-independent'],
               other_classes={k: v for k, v in c.items() if k not in (
                   'WHITE-WINS-ALL', 'BLACK-WINS-ALL', 'on/on+*', 'off/off+*', 'dud', 'unmatched, T-dependent',
                   'unmatched, T-independent')},
               seconds=round(sum(r['seconds'] for r in mine), 1),
               gafni_seconds=meta['seconds'],
               peak_rss_mb=max([r.get('tree_maxrss_mb', 0) for r in mine] + [0]),
               peak_polled_rss_mb=max([r['peak_single_rss_mb'] for r in mine] + [0]),
               peak_polled_total_mb=max([r['peak_total_rss_mb'] for r in mine] + [0]))
    assert sum(c.values()) == out['quiet']
    return out


if __name__ == '__main__':
    print(json.dumps([summarize(b) for b in sys.argv[1:]], indent=1))

 succeeded in 0ms:
"""K4 driver: signatures of K+P vs K quiet placements against 16 test games, flat and cylinder.

    PYTHONPATH=. nice -n 10 .venv/bin/python kings/delegate/out/K4/gafni.py flat:3x4 cyl:3x4 ...

Per board it (1) builds the chess graph, (2) runs check 1 against kpsolve (stops if any difference),
(3) solves x (+) T for the 16 test games T and, for every candidate V that some placement matches,
x (+) (-V), (4) writes <flat|cyl>_<W>x<H>.jsonl (one line per quiet placement) and meta_<board>.json.
Check 2 (pure CGT facts) is run once, first, by checks.py and must pass.
"""

import json
import os
import sys
import time

import checks
import check1
import graph
import testgames as tg
from product import solve_product, pure

HERE = os.path.dirname(os.path.abspath(__file__))
DIFF_W_OK = ('D', 'L')      # White starts: second-player survival means White does not win
DIFF_B_OK = ('D', 'W')      # Black starts: Black does not win


def candidate_signatures():
    """{name: 32-char signature} of V (+) T for the 26 candidates V and 16 test games T."""
    out = {}
    for name, V in tg.candidates():
        sig = ''
        for t in tg.TESTS:
            a, b = pure(tg.plus(V, tg.GAMES[t]))
            sig += a + b
        out[name] = sig
    return out


def signatures(cg):
    """{(white-to-move node, black-to-move node): 32-char signature} over the quiet KPK placements."""
    sigs = {pair: [] for pair in cg.quiet_kpk}
    for t in tg.TESTS:
        T = tg.GAMES[t]
        res = solve_product(cg, T)
        for cw, cb in cg.quiet_kpk:
            sigs[(cw, cb)].append('DWL'[res[cw * T.n + T.start]] + 'DWL'[res[cb * T.n + T.start]])
    return {k: ''.join(v) for k, v in sigs.items()}


def process(board, cand_sigs, workdir):
    t0 = time.time()
    cg = graph.ChessGraph(board)
    c1 = check1.check1(cg, os.path.join(workdir, 'check1'))
    if c1['diffs']:
        print('CHECK 1 FAILED on', board, c1['diffs'][:10])
        json.dump(c1, open(os.path.join(workdir, 'FAILED_check1_%s.json' % board.replace(':', '_')), 'w'), indent=1)
        sys.exit(2)
    sigs = signatures(cg)
    chess = solve_product(cg, tg.GAMES['0'], stalemate_draw=True)
    by_sig = {}
    for name, s in cand_sigs.items():
        by_sig.setdefault(s, []).append(name)
    matched = {pair: by_sig.get(s, []) for pair, s in sigs.items()}
    # difference tests: x (+) (-V) for every V that some placement matches
    used = sorted({v for m in matched.values() for v in m}, key=list(cand_sigs).index)
    cands = dict(tg.candidates())
    diff = {}
    for v in used:
        nv = tg.neg(cands[v])
        res = solve_product(cg, nv)
        diff[v] = {pair: ('DWL'[res[pair[0] * nv.n + nv.start]], 'DWL'[res[pair[1] * nv.n + nv.start]])
                   for pair in cg.quiet_kpk}
    path = os.path.join(workdir, board.replace(':', '_') + '.jsonl')
    n_all_w = n_all_l = n_unm = 0
    with open(path, 'w') as f:
        for pair in sorted(cg.quiet_kpk, key=lambda p: cg.placement(p[0])):
            cw, cb = pair
            sig = sigs[pair]
            dec = 'W' if set(sig) == {'W'} else 'L' if set(sig) == {'L'} else None
            m = matched[pair]
            cls = ('WHITE-WINS-ALL' if dec == 'W' else 'BLACK-WINS-ALL' if dec == 'L'
                   else '/'.join(m) if m else 'unmatched')
            n_all_w += dec == 'W'
            n_all_l += dec == 'L'
            n_unm += (not m and dec is None)
            stm, wk, bk, offs, wp, bp, ep = cg.pos[cw]
            line = dict(board=board, placement=cg.placement(cw),
                        wk=cg.sqname(wk), p=cg.sqname(wp.bit_length() - 1), bk=cg.sqname(bk),
                        sig=sig, decisive=dec, matched=m, cls=cls,
                        chess=['DWL'[chess[cw]], 'DWL'[chess[cb]]],
                        diff={v: dict(white_starts=diff[v][pair][0], black_starts=diff[v][pair][1],
                                      second_player=(diff[v][pair][0] in DIFF_W_OK and diff[v][pair][1] in DIFF_B_OK))
                              for v in m})
            f.write(json.dumps(line, ensure_ascii=False) + '\n')
    meta = dict(board=board, nodes=cg.n, edges=len(cg.succ), kpk_positions=len(cg.kpk),
                quiet_placements=len(cg.quiet_kpk), check1={k: v for k, v in c1.items() if k != 'diffs'},
                check1_differences=len(c1['diffs']), decisive_white=n_all_w, decisive_black=n_all_l,
                unmatched=n_unm, seconds=round(time.time() - t0, 1), jsonl=os.path.basename(path))
    json.dump(meta, open(os.path.join(workdir, 'meta_%s.json' % board.replace(':', '_')), 'w'), indent=1)
    print(board, meta, flush=True)
    return meta


def main(argv):
    c2 = checks.check2()
    for desc, exp, got, reading, ok in c2:
        print('check2 %-4s %-22s %s' % ('PASS' if ok else 'FAIL', desc, got))
    if not all(r[4] for r in c2):
        sys.exit('check 2 failed')
    cand = candidate_signatures()
    json.dump(dict(tests=tg.TESTS, order='for each test game: White-starts char, Black-starts char',
                   candidates=cand), open(os.path.join(HERE, 'candidates.json'), 'w'), indent=1)
    for board in argv:
        process(board, cand, HERE)


if __name__ == '__main__':
    main(sys.argv[1:])
"""Integer scan: results of x (+) n for n = -10..10 at every quiet K+P vs K placement.

    PYTHONPATH=. nice -n 10 .venv/bin/python kings/delegate/out/K4/tempo_scan.py flat:3x4 cyl:3x4 ...

An integer n is a finite supply of |n| spare moves for White (n > 0) or Black (n < 0).  A placement
whose results change between n and n+1 has a tempo threshold there.  The scan extends the signature,
which only has n = -2..2, to see whether any threshold lies beyond +-2.
"""

import collections
import json
import os
import sys

import graph
import testgames as tg
from product import solve_product

HERE = os.path.dirname(os.path.abspath(__file__))
RANGE = range(-10, 11)


def scan(board):
    cg = graph.ChessGraph(board)
    prof = {pair: [] for pair in cg.quiet_kpk}
    for n in RANGE:
        T = tg.integer(n)
        res = solve_product(cg, T)
        for cw, cb in cg.quiet_kpk:
            prof[(cw, cb)].append('DWL'[res[cw * T.n + T.start]] + 'DWL'[res[cb * T.n + T.start]])
    out = []
    for (cw, cb), pr in prof.items():
        jumps = [n for n, a, b in zip(list(RANGE), pr, pr[1:]) if a != b]    # change between n and n+1
        out.append((cg.placement(cw), pr, jumps))
    return out


def summarize(board, rows):
    c = collections.Counter()
    for pl, pr, jumps in rows:
        c['max|jump| = %s' % (max(max(j, -j - 1) + (1 if j >= 0 else 0) for j in jumps) if jumps else 'none')] += 1
    return c


if __name__ == '__main__':
    lines = []
    for board in sys.argv[1:]:
        rows = scan(board)
        nj = collections.Counter(len(j) for _, _, j in rows)
        jump_at = collections.Counter(n for _, _, js in rows for n in js)
        far = [(pl, js) for pl, _, js in rows if any(j >= 2 or j <= -3 for j in js)]
        rec = dict(board=board, placements=len(rows), number_of_jumps=dict(sorted(nj.items())),
                   jump_between_n_and_n_plus_1={str(k): v for k, v in sorted(jump_at.items())},
                   placements_with_a_jump_beyond_pm2=len(far), examples_beyond_pm2=far[:5],
                   all_profiles_constant_for_n_ge_2_and_n_le_minus_2=(not far))
        print(json.dumps(rec), flush=True)
"""K6: per-placement tempo profiles, built on tempo_scan.scan (same code, same results).

    PYTHONPATH=. nice -n 10 .venv/bin/python kings/delegate/out/K6/tempo_detail.py flat:6x4 cyl:7x4 ...

For every quiet placement x it takes
  * the 11 finite test results from <board>.jsonl (tests 0, 1, 2, -1, -2, *, up, down, 1/2, -1/2, +-1),
  * the results of x (+) n for n = -10..10 from tempo_scan.scan,
and calls the placement TEMPO-SENSITIVE if these results (a two-letter pair: White starts, Black starts) are not all
equal.  Writes tempo_detail_<board>.json: counts, thresholds (n with result(n) != result(n+1)) and every sensitive
placement with its profile.  It asserts that its jump counts equal the line tempo_scan.py printed (tempo_scan.jsonl).
"""
import collections
import json
import os
import sys

import tempo_scan
import testgames as tg

HERE = os.path.dirname(os.path.abspath(__file__))
FINITE = ['0', '1', '2', '-1', '-2', '*', 'up', 'down', '1/2', '-1/2', '+-1']      # first 11 of tg.TESTS
assert tg.TESTS[:11] == FINITE
NS = list(tempo_scan.RANGE)


def runs(profile):
    """'n<=-2: DD | n=-1: DW | n>=0: WW' style run-length text of the 21 results n = -10..10."""
    out, start = [], 0
    for i in range(1, len(profile) + 1):
        if i == len(profile) or profile[i] != profile[start]:
            a, b = NS[start], NS[i - 1]
            lab = ('n<=%d' % b if a == NS[0] else 'n>=%d' % a if b == NS[-1] else
                   'n=%d' % a if a == b else 'n=%d..%d' % (a, b))
            out.append('%s: %s' % (lab, profile[start]))
            start = i
    return ' | '.join(out)


def detail(board):
    tag = board.replace(':', '_')
    sig = {}
    for line in open(os.path.join(HERE, tag + '.jsonl')):
        r = json.loads(line)
        sig[r['placement']] = r['sig']
    rows = tempo_scan.scan(board)
    assert len(rows) == len(sig), (len(rows), len(sig))
    nj = collections.Counter(len(j) for _, _, j in rows)
    thr = collections.Counter(n for _, _, js in rows for n in js)
    fin_sens = n_sens = union_sens = 0
    sensitive = []
    for pl, prof, jumps in rows:
        s = sig[pl]
        fin = [s[2 * i:2 * i + 2] for i in range(11)]
        a = len(set(fin)) > 1
        b = len(set(prof)) > 1
        fin_sens += a
        n_sens += b
        if a or b:
            union_sens += 1
            sensitive.append(dict(placement=pl, finite_tests=dict(zip(FINITE, fin)), n_profile=runs(prof),
                                  n_profile_full=dict(zip(map(str, NS), prof)), jumps_at=jumps))
    # cross-check against the line tempo_scan.py printed for this board
    ts = [json.loads(l) for l in open(os.path.join(HERE, 'tempo_scan.jsonl'))]
    ts = [d for d in ts if d['board'] == board]
    assert len(ts) == 1, 'tempo_scan.jsonl needs exactly one line for %s' % board
    assert ts[0]['placements'] == len(rows)
    assert ts[0]['number_of_jumps'] == {str(k): v for k, v in sorted(nj.items())}, 'jump counts differ'
    assert ts[0]['jump_between_n_and_n_plus_1'] == {str(k): v for k, v in sorted(thr.items())}, 'thresholds differ'
    rec = dict(board=board, quiet=len(rows), tempo_sensitive=union_sens, sensitive_to_finite_tests=fin_sens,
               sensitive_to_n_scan=n_sens, thresholds={str(k): v for k, v in sorted(thr.items())},
               max_jump_beyond_pm2=ts[0]['placements_with_a_jump_beyond_pm2'], sensitive=sensitive)
    json.dump(rec, open(os.path.join(HERE, 'tempo_detail_%s.json' % tag), 'w'), indent=1, ensure_ascii=False)
    print(json.dumps({k: v for k, v in rec.items() if k != 'sensitive'}), flush=True)


if __name__ == '__main__':
    for b in sys.argv[1:]:
        detail(b)

