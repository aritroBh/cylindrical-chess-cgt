+    def __init__(self):
+        if sys.platform != 'darwin':
+            raise RuntimeError('this runlim copy needs macOS libproc when ps is sandboxed')
+        self.lib = ctypes.CDLL('/usr/lib/system/libsystem_kernel.dylib')
