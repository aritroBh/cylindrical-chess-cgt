+        copied = self.lib.proc_listchildpids(pid, buf, ctypes.sizeof(buf))
+        if copied < 0:
+            return []
+        return list(buf[:min(copied // ctypes.sizeof(ctypes.c_int), len(buf))])
 
+    def tree(self, root):
