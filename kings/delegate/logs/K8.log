"""Chess move graph for K4: all positions reachable from K+P vs K, built once per board.

Uses the reference solver's move generator (kings/ref/solve.py) unchanged:
    solver.moves(pos, full=True) -> (n_quiet, quiet_successors, exits)
    solver.in_check(pos)
A position is the tuple (stm, wk, bk, offs, wp, bp, ep); here ep is always -1 (Black has no pawn).

Node set = closure of {every legal K+P vs K position, either side to move} under
  * chess moves (promotion gives K+officer vs K, a king capture gives K vs K), and
  * the PASS (same placement, other side to move), which exists exactly when the mover is not in
    check.  The pass is the chess half of a move made in a test game T (see product.py).
CSR arrays: succ (chess moves), pred (reverse), flip (pass target or -1), incheck (mover in check).
"""

from array import array

from kings.ref.solve import make_solver, CAPPED

WHITE, BLACK = 0, 1


class ChessGraph:
    def __init__(self, board):
        self.board = board
        self.solver = make_solver(board=board, ep='on', promote='QRBN', cap=1)
        self.pos = []            # node id -> position tuple
        self.idx = {}            # position tuple -> node id
        self.stm = bytearray()
        self.incheck = bytearray()
        self.flip = array('i')
        self.succ_off = array('i', [0])
        self.succ = array('i')
        self.kpk = []            # node ids of KPK positions (no officer, one white pawn)
        self.quiet_kpk = []      # placements (wk, wp, bk) with neither king in check, as node pairs
        self._build()

    # -- construction -------------------------------------------------------------------
    def _add(self, p, todo):
        i = self.idx.get(p)
        if i is None:
            i = self.idx[p] = len(self.pos)
            self.pos.append(p)
            todo.append(i)
        return i

    def initial(self):
        g = self.solver.g
        out = []
        for wk in range(g.N):
            for bk in range(g.N):
                if wk == bk or g.king_mask[wk] >> bk & 1:
                    continue
                for wp in range(g.N):
                    if wp in (wk, bk) or g.rank[wp] in (0, g.H - 1):
                        continue
                    for stm in (WHITE, BLACK):
                        p = (stm, wk, bk, (), 1 << wp, 0, -1)
                        if not self.solver.in_check(p, 1 - stm):   # side not to move in check: illegal
                            out.append(p)
        return out

    def _build(self):
        S = self.solver
        todo = []
        for p in self.initial():
            self._add(p, todo)
        self.n_initial = len(self.pos)
        rows, flips, chk = {}, {}, {}
        while todo:
            i = todo.pop()
            p = self.pos[i]
            nq, quiet, exits = S.moves(p, full=True)
            succs = list(quiet)
            for tag, q in exits:
                assert tag != CAPPED, 'capped promotion with one pawn: %r' % (p,)
                succs.append(q)
            rows[i] = [self._add(q, todo) for q in succs]
            chk[i] = S.in_check(p)
            flips[i] = -1 if chk[i] else self._add((1 - p[0],) + p[1:], todo)
        n = len(self.pos)
        for i in range(n):
            self.stm.append(self.pos[i][0])
            self.incheck.append(1 if chk[i] else 0)
            self.flip.append(flips[i])
            self.succ.extend(rows[i])
            self.succ_off.append(len(self.succ))
        self.n = n
        # reverse adjacency (CSR)
        cnt = [0] * (n + 1)
        for j in self.succ:
            cnt[j + 1] += 1
        for k in range(n):
            cnt[k + 1] += cnt[k]
        self.pred_off = array('i', cnt)
        fill = list(cnt[:n])
        self.pred = array('i', [0]) * len(self.succ)
        for i in range(n):
            for k in range(self.succ_off[i], self.succ_off[i + 1]):
                j = self.succ[k]
                self.pred[fill[j]] = i
                fill[j] += 1
        # K+P vs K nodes and quiet placements
        for i, p in enumerate(self.pos):
            if not p[3] and p[4] and not p[5] and bin(p[4]).count('1') == 1:
                self.kpk.append(i)
        for i in self.kpk:
            if self.stm[i] == WHITE and self.flip[i] >= 0:
                self.quiet_kpk.append((i, self.flip[i]))   # (white to move, black to move)

    # -- helpers ------------------------------------------------------------------------
    def sqname(self, s):
        return self.solver.g.sqname(s)

    def placement(self, i):
        """'Ka1 Pb2 kc3' (squares of WK, P, BK) for a K+P vs K node."""
        stm, wk, bk, offs, wp, bp, ep = self.pos[i]
        return 'K%s P%s k%s' % (self.sqname(wk), self.sqname(wp.bit_length() - 1), self.sqname(bk))

    def kp_line(self, i):
        """Input line for kpsolve."""
        stm, wk, bk, offs, wp, bp, ep = self.pos[i]
        toks = ['K' + self.sqname(wk), 'k' + self.sqname(bk)]
        if wp:
            toks.append('P' + self.sqname(wp.bit_length() - 1))
        for c, ty, s in offs:
            ch = 'QRBN'[ty]
            toks.append((ch if c == WHITE else ch.lower()) + self.sqname(s))
        return ' '.join(toks) + (' w -' if stm == WHITE else ' b -')


class DummyGraph:
    """No chess at all: two nodes (White to move, Black to move) that pass to each other.
    dummy x T is then exactly the CGT game T under normal play."""
    n = 2
    stm = bytearray([0, 1])
    incheck = bytearray([0, 0])
    flip = array('i', [1, 0])
    succ_off = array('i', [0, 0, 0])
    succ = array('i')
    pred_off = array('i', [0, 0, 0])
    pred = array('i')
    board = 'none'
"""Test games for K4 (rewritten; the earlier file in this directory had a wrong -1/2).

A game is an explicit graph with Left = White and Right = Black.  Node i has Left options
lopts[i] and Right options ropts[i] (lists of node indices); `start` is the node that stands for
the game.  There are no terminals: a player with no option loses (normal play), and infinite play
is a draw (decided by product.py).

Brief K4 says "17 test games" but lists 16 (0, 1, 2, -1, -2, *, up, down, 1/2, -1/2, +-1, on,
off, dud, over, under).  TESTS below holds exactly the 16 listed; the signature length follows
len(TESTS), so a 17th game would be one more line.
"""

import itertools


class Game:
    __slots__ = ('name', 'n', 'lopts', 'ropts', 'lpred', 'rpred', 'start')

    def __init__(self, name, lopts, ropts, start=0):
        self.name = name
        self.n = len(lopts)
        self.lopts = lopts
        self.ropts = ropts
        self.start = start
        self.lpred = [[] for _ in range(self.n)]
        self.rpred = [[] for _ in range(self.n)]
        for i in range(self.n):
            for j in lopts[i]:
                self.lpred[j].append(i)
            for j in ropts[i]:
                self.rpred[j].append(i)

    def opts(self, side):
        """side 0 = Left/White, 1 = Right/Black"""
        return self.lopts if side == 0 else self.ropts

    def preds(self, side):
        return self.lpred if side == 0 else self.rpred


def from_spec(name, spec, start):
    """spec: {node name: ([left option names], [right option names])}; start: node name."""
    names = list(spec)
    idx = {nm: i for i, nm in enumerate(names)}
    lo = [[idx[x] for x in spec[nm][0]] for nm in names]
    ro = [[idx[x] for x in spec[nm][1]] for nm in names]
    return Game(name, lo, ro, idx[start])


def neg(g, name=None):
    """-g: Left and Right swap roles at every node."""
    return Game(name or '-(%s)' % g.name, [list(x) for x in g.ropts],
                [list(x) for x in g.lopts], g.start)


def plus(*games, name=None):
    """Disjunctive sum (product graph); node (i1, ..., ik) has index in row-major order."""
    acc = games[0]
    for h in games[1:]:
        lo, ro = [], []
        for i, j in itertools.product(range(acc.n), range(h.n)):
            lo.append([a * h.n + j for a in acc.lopts[i]] + [i * h.n + b for b in h.lopts[j]])
            ro.append([a * h.n + j for a in acc.ropts[i]] + [i * h.n + b for b in h.ropts[j]])
        acc = Game('', lo, ro, acc.start * h.n + h.start)
    acc.name = name or '+'.join(g.name for g in games)
    return acc


def _int(n):
    """n >= 1: {n-1 | }, chain down to 0.  n <= -1: { | n+1}."""
    spec = {'0': ([], [])}
    k = abs(n)
    for i in range(1, k + 1):
        spec[str(i)] = (['0' if i == 1 else str(i - 1)], []) if n > 0 else \
                       ([], ['0' if i == 1 else str(i - 1)])
    return spec, str(k)


def integer(n):
    """The integer n as a game (n = 0 is the game 0); used by tempo_scan.py."""
    if n == 0:
        return GAMES['0']
    spec, st = _int(n)
    return from_spec(str(n), spec, st)


def _build():
    S = {}
    S['0'] = ({'0': ([], [])}, '0')
    S['1'] = _int(1)
    S['2'] = _int(2)
    S['-1'] = _int(-1)
    S['-2'] = _int(-2)
    S['*'] = ({'*': (['0'], ['0']), '0': ([], [])}, '*')
    S['up'] = ({'up': (['0'], ['*']), '*': (['0'], ['0']), '0': ([], [])}, 'up')
    S['down'] = ({'down': (['*'], ['0']), '*': (['0'], ['0']), '0': ([], [])}, 'down')
    S['1/2'] = ({'h': (['0'], ['1']), '1': (['0'], []), '0': ([], [])}, 'h')
    S['-1/2'] = ({'h': (['-1'], ['0']), '-1': ([], ['0']), '0': ([], [])}, 'h')
    S['+-1'] = ({'pm': (['1'], ['-1']), '1': (['0'], []), '-1': ([], ['0']),
                 '0': ([], [])}, 'pm')
    S['on'] = ({'on': (['on'], [])}, 'on')
    S['off'] = ({'off': ([], ['off'])}, 'off')
    S['dud'] = ({'dud': (['dud'], ['dud'])}, 'dud')
    S['over'] = ({'over': (['0'], ['over']), '0': ([], [])}, 'over')
    S['under'] = ({'under': (['under'], ['0']), '0': ([], [])}, 'under')
    return {k: from_spec(k, spec, st) for k, (spec, st) in S.items()}


GAMES = _build()
TESTS = ['0', '1', '2', '-1', '-2', '*', 'up', 'down', '1/2', '-1/2', '+-1',
         'on', 'off', 'dud', 'over', 'under']
PRETTY = {'up': '↑', 'down': '↓', '+-1': '±1', '-1/2': '−1/2'}


def pretty(name):
    for k, v in PRETTY.items():
        name = name.replace(k, v)
    return name.replace('-', '−') if name not in PRETTY.values() else name


def _pair(nm, left, right):
    """{left | right} where left/right are game names ('' = none); copies the option graphs."""
    # build a fresh graph: root node, then disjoint copies of the option games
    lo, ro, off = [[]], [[]], 1
    starts = {}
    for side, gname in ((0, left), (1, right)):
        if not gname:
            continue
        g = GAMES[gname]
        base = off
        off += g.n
        for i in range(g.n):
            lo.append([base + a for a in g.lopts[i]])
            ro.append([base + a for a in g.ropts[i]])
        starts[side] = base + g.start
    if 0 in starts:
        lo[0].append(starts[0])
    if 1 in starts:
        ro[0].append(starts[1])
    return Game(nm, lo, ro, 0)


def candidates():
    """The 26 candidate values V as (name, Game): 16 tests, five sums with *, five {a|b}."""
    c = [(t, GAMES[t]) for t in TESTS]
    for a in ('on', 'off', '1', '-1', 'up'):
        c.append((a + '+*', plus(GAMES[a], GAMES['*'], name=a + '+*')))
    for l, r in (('on', '0'), ('0', 'off'), ('on', 'off'), ('0', 'on'), ('off', '0')):
        c.append(('{%s|%s}' % (l, r), _pair('{%s|%s}' % (l, r), l, r)))
    return c


if __name__ == '__main__':
    for nm, g in candidates():
        print(nm, g.n, g.start)

