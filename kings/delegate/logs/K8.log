new file mode 100644
index 0000000000000000000000000000000000000000..6a7e244b2715f9a1674d8a06ba6d419860e6e76d
--- /dev/null
+++ b/kings/delegate/out/K8/run.sh
@@ -0,0 +1,40 @@
+#!/bin/sh
+# Reproduce all K8 normal-play and chess-stalemate scans from the project root.
+cd "$(dirname "$0")/../../../.." || exit 1
+export PYTHONPATH=.
+K8=kings/delegate/out/K8
+PY=.venv/bin/python
+
+# Start clean inside this task's output directory; retain source scripts.
+mkdir -p "$K8/check1"
+rm -f "$K8"/flat_*.jsonl "$K8"/cyl_*.jsonl "$K8"/tempo_scan.jsonl \
+  "$K8"/chess_tempo_*.jsonl "$K8"/runs.jsonl "$K8"/meta_*.json \
+  "$K8"/tempo_detail_*.json "$K8"/log_*.txt "$K8"/FAILED*.json "$K8"/check1/*.gz
+
+nice -n 10 cc -O2 -o "$K8/kp" kings/kpsolve.c || exit $?
+export K8_START=$(date +%s)
+
+# Task 1: predictions, smallest first, followed by the optional boards.
+sh "$K8/run_all.sh" \
+  cyl:5x4 cyl:3x7 cyl:5x7 cyl:3x8 cyl:4x7 cyl:4x8 flat:4x6 flat:3x7 \
+  cyl:2x6 cyl:2x8 cyl:6x7 || exit $?
+
+# Task 2: chess stalemate rule; chess_scan runs the T=0 kpsolve check before any scan.
+for b in flat:3x4 flat:4x4 cyl:4x4 cyl:4x6 flat:5x6 \
+         cyl:3x6 cyl:5x6 cyl:6x5 cyl:7x5; do
+  now=$(date +%s)
+  remaining=$((7200 - now + K8_START))
+  if [ "$remaining" -le 0 ]; then echo "2-hour limit reached before chess $b"; exit 99; fi
+  limit=1200
+  if [ "$remaining" -lt "$limit" ]; then limit=$remaining; fi
+  tag=$(echo "$b" | tr ':' '_')
+  echo "=== chess $b start $(date +%T) limit=${limit}s"
+  nice -n 10 "$PY" "$K8/runlim.py" "chess $b" "$limit" 3000 "$K8/runs.jsonl" -- \
+    nice -n 10 "$PY" "$K8/chess_scan.py" "$b" > "$K8/log_chess_$tag.txt" 2>&1
+  rc=$?
+  tail -n 6 "$K8/log_chess_$tag.txt" | cut -c1-700
+  if [ "$rc" -ne 0 ]; then echo "chess board failed/skipped: $b rc=$rc"; exit "$rc"; fi
+done
+
+nice -n 10 "$PY" "$K8/summarize.py" > "$K8/summary.json" || exit $?
+echo "K8 complete: $K8/summary.json"
